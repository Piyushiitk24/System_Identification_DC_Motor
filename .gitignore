!data/raw/serial_logs/*.log
*.bak
*.orig
*.rej
tmp/
temp/
scratch/
outputs/
local_outputs/
run_outputs/

# ---------------------------------------------------------------------------
# FreeCAD / CAD generated backups and temp files
# Keep source CAD/STL/STEP files trackable; ignore backup/scratch exports.
# ---------------------------------------------------------------------------
*.FCBak
*.FCStd1
*.FCStd2
*.fcstd1
*.fcstd2
*.FCStdTmp
*.Part
*.part
*.stp.tmp
*.step.tmp
